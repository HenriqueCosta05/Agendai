PORT=3000

# Signs access tokens, at least 32 bytes. Generate with: openssl rand -base64 32
JWT_SECRET=

# Used by the db container
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=agendai

# Running the API on the host (npm run start:dev)
DATABASE_URL=postgres://app:change-me@localhost:5432/agendai

# Running the API in Docker Compose (the host name is the db service)
DOCKER_DATABASE_URL=postgres://app:change-me@db:5432/agendai

# NestJS Observe keys. Get them with: npx @nestjs/observe link
# Without them the API runs and sends no telemetry.
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
