  "cards": [
    {
      "dot": "cyan",
      "title": "Authentication",
      "items": [
        "The token proves the subject, and the user is loaded from PostgreSQL on every request",
        "A deleted user therefore loses access even with an unexpired token",
        "The role comes from the database, not from the token"
      ]
    },
    {
      "dot": "amber",
      "title": "Authorization",
      "items": [
        "AccessPolicy.manage allows only the admin role",
        "A signed-in professional or client is refused before the service runs"
      ]
    },
    {
      "dot": "emerald",
      "title": "Validation",
      "items": [
        "The body is validated against createUnitSchema before the handler runs",
        "The unit receives the tenant of the loaded user, never a value from the body"
      ]
    }
  ]
