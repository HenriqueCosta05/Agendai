{
  "name": "Agendai",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "complexity": "node scripts/check-complexity.mjs",
    "comments": "node scripts/check-comments.mjs",
    "comments:migrate": "node scripts/check-comments.mjs --migrate",
    "review": "node scripts/review-best-practices.mjs",
    "gate": "npm run lint && npm run typecheck && npm run test && npm run complexity && npm run comments"
  },
  "dependencies": {
    "@nestjs/authentication": "^0.1.7",
    "@nestjs/authorization": "^0.1.4",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/drizzle": "^0.0.2",
    "@nestjs/platform-express": "^12.0.1",
    "@prometheus-io/client": "^0.16.1",
    "drizzle-orm": "^1.0.0-rc.6",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.6.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^1.0.0-rc.6",
    "eslint": "^10.15.0",
    "eslint-plugin-security": "^4.2.1",
    "supertest": "^7.3.2",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
