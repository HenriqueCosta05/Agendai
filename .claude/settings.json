{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/user-prompt-gate.sh",
            "timeout": 15,
            "statusMessage": "Prompt gate..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pre-tool-gate.sh",
            "timeout": 300,
            "onFailure": "block",
            "statusMessage": "Quality gate: lint, types, tests, complexity, comments..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/post-tool-review.sh",
            "timeout": 60,
            "statusMessage": "Reviewing security and best practices..."
          }
        ]
      }
    ]
  }
}
